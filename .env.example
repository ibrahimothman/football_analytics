# Airflow
AIRFLOW_UID=50000

# Pipeline paths (relative for local; use /opt/airflow/... in Docker if needed)
FOOTBALL_DATA_ROOT=data
FOOTBALL_REPORTS_ROOT=reports
FOOTBALL_MODELS_ROOT=models

# Ingestion
FOOTBALL_PROVIDER=statsbomb_open_data
STATSBOMB_EVENTS_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data/events
HTTP_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
